# Copy to .env for local development. Only DATABASE_URL is required (ADR 0030).
DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/owncryptofolio

# Tests run against their own database; it is wiped by the test run.
TEST_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/owncryptofolio_test

APP_ENV=development

# Optional. Default: src/backend/.data (container: /data). Holds secrets/keys.json.
# DATA_DIR=/data

# Optional key overrides (Fernet keys). Generated on first start when absent.
# CREDENTIALS_KEY=
# SESSION_KEY=
# BACKUP_KEY=
